# Copy this file to .env and fill in the values.

# Port the API listens on.
PORT=4000

# Comma-separated list of websites allowed to call the API (your frontend's address).
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# From Supabase → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Also from Supabase → Project Settings → API ("service_role" key).
# SECRET: never put this in the frontend. Only needed for the /admin endpoints and logout.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Send it as the "x-admin-key" header to use the /admin endpoints.
# Leave empty to turn the admin endpoints off.
ADMIN_API_KEY=
